{
  "scenario_override_version": "v1",
  "scenario_id": "flexible_load_comfort_v4_v2g_sensitivity",
  "scenario_family": "demand_flexibility_service_constrained",
  "description": "V4 V2G sensitivity using the same continuous thermal and fleet-mobility contract as V4 V1G. It is not Base and cannot run until the V4 calibration inputs are supplied and accepted.",
  "evidence_status": "CALIBRATION_INPUT_CONTRACT_REQUIRED",
  "overrides": {
    "features": {
