{
  "scenario_override_version": "v1",
  "scenario_id": "flexible_load_comfort_v4_v2g_sensitivity",
  "scenario_family": "demand_flexibility_service_constrained",
  "description": "V4 V2G sensitivity using the same data-supported thermal and aggregate EV service inventory as V4 V1G. It is not Base and does not claim observed connection or departure behavior.",
  "evidence_status": "ENGINEERING_SENSITIVITY_ONLY",
  "overrides": {
    "features": {
      "flexible_load": true
    },
    "flexible_load": {
      "contract_version": "v4",
      "formulation": "service_constrained_v4",
      "state_boundary": "periodic_selected_horizon_v1",
      "v4_reference_energy_closure_tolerance_fraction": 0.000001,
      "v4_input_files": {
        "thermal_hourly_envelope_file": "flexibility/thermal_hourly_envelope_v4.csv.gz",
        "thermal_parameters_file": "flexibility/thermal_parameters_by_province_v4.csv",
        "ev_availability_hourly_file": "flexibility/ev_availability_hourly_v4.csv.gz",
        "ev_mobility_hourly_file": "flexibility/ev_mobility_hourly_v4.csv.gz",
        "enablement_cost_file": "flexibility/flex_enablement_cost_v4.csv",
        "input_manifest_file": "flexibility/flexible_load_v4.manifest.json"
      },
      "heating": {
        "enabled": true
      },
      "cooling": {
        "enabled": true
      },
      "ev_v1g": {
        "enabled": true,
        "shiftable_energy_fraction": 0.25,
        "maximum_power_to_daily_average_ratio": 2.0
      },
      "ev_v2g": {
        "enabled": true,
        "state_boundary": "periodic_selected_horizon_v1",
        "charge_efficiency": 0.94,
        "discharge_efficiency": 0.94,
        "self_discharge_fraction_per_hour": 0.0
      },
      "parameter_status": {
        "v2g_scope": "Sensitivity only: the same aggregate service inventory must first satisfy the 25% schedulable charging service; V2G power is capped from a 10% participation assumption and charged 180 CNY/MWh in the central parameter file."
      }
    }
  }
}
